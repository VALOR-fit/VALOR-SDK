# Costas Andreopoulos <constantinos.andreopoulos \at cern.ch>
#

include $(VALOR_FMWK)/make/Make.config

ifeq ("YES","$(OPT_ENABLE_GENIE)")
include $(GENIE)/src/make/Make.config
endif

ifndef OPT_WITH_CXX_USERDEF_FLAGS
 OPT_WITH_CXX_USERDEF_FLAGS=
endif

# Check if this is a "clean" command, we can skip some stuff
ifeq (clean,$(findstring clean,$(MAKECMDGOALS)))
  is_cln="true"
else
  is_cln="false"
endif

#-------------------------------------------------------------------
#                           ARCHITECTURE 
#-------------------------------------------------------------------
# As defined by ROOT
ARCH      = $(shell root-config --arch)  
ARCH_OK   = 
IS_MACOSX =

#-------------------------------------------------------------------
#                           ANALYSIS CODE
#-------------------------------------------------------------------

# VALOR release info
#
VALOR_VERSION  = $(shell awk '{print $0}' $(VALOR_FMWK)/VERSION)

# VALOR paths
#
VALOR_INCLUDES := -I$(VALOR_FMWK)/src/

# VALOR FMWK libraries
#
ifeq ("false",$(is_cln))
  VALOR_FMWK_LIBRARIES = $(shell valor_fmwk-config --libs 2>/dev/null)
endif

#-------------------------------------------------------------------
#                              ROOT
#-------------------------------------------------------------------

# ROOT headers and libraries
ROOT_FLAGS  = $(shell root-config --cflags)
ROOT_INCLUDES  = -I$(shell root-config --incdir)
ROOT_LIBRARIES = $(shell root-config --glibs) -lMinuit -lMinuit2 -lMathMore -lXMLIO -lXMLParser
ROOT_CINT_FLAGS = -c -p
ROOT_CINT_FLAGS = 

# If ROOT doesn't specify a C++ standard, use 0x:
ifeq (,$(findstring -std=,$(ROOT_FLAGS)))
  ROOT_FLAGS += -std=c++0x 
endif

ROOT_VERSION = $(shell root-config --version )
ROOT_MAJOR   = $(shell root-config --version | cut -d. -f1 )

#-------------------------------------------------------------------
#                             log4cpp
#-------------------------------------------------------------------

# log4cpp lib & include directory

ifdef OPT_WITH_LOG4CPP_INC
LOG_INC_DIR = $(OPT_WITH_LOG4CPP_INC)
else
LOG_INC_DIR = /opt/local/include
endif

ifdef OPT_WITH_LOG4CPP_LIB
LOG_LIB_DIR = $(OPT_WITH_LOG4CPP_LIB)
else
LOG_LIB_DIR = /opt/local/lib
endif

# log4cpp libraries and headers

LOG_INCLUDES  := -I$(LOG_INC_DIR)
LOG_LIBRARIES := -L$(LOG_LIB_DIR) -llog4cpp

#-------------------------------------------------------------------
#                             GSL
#-------------------------------------------------------------------

# GSL libraries and headers

ifneq ($(OPT_WITH_GSL_INC),)
  GSL_INCLUDES  := -I$(OPT_WITH_GSL_INC)
else
  GSL_INCLUDES  := 
endif

ifneq ($(OPT_WITH_GSL_LIB),)
  GSL_LIBRARIES  := -L$(OPT_WITH_GSL_LIB)
else
  GSL_LIBRARIES  := 
endif

#-------------------------------------------------------------------
#                            GENIE MC
#-------------------------------------------------------------------

ifeq ("YES","$(OPT_ENABLE_GENIE)")

# extra GENIE/Generator includes
  GENIE_INCLUDES = -I$(shell genie-config --topsrcdir)

# extra GENIE/Reweight includes
ifdef GENIE_REWEIGHT
  GENIE_INCLUDES += -I$(GENIE_REWEIGHT)/src
endif

# other ext includes needed for GENIE
GENIE_OTHER_EXT_INCLUDES =
ifdef GOPT_WITH_PYTHIA8_INC
  GENIE_OTHER_EXT_INCLUDES += -I$(GOPT_WITH_PYTHIA8_INC) 
endif
ifdef GOPT_WITH_LHAPDF5_INC
  GENIE_OTHER_EXT_INCLUDES += -I$(GOPT_WITH_LHAPDF5_INC)
endif
ifdef GOPT_WITH_LHAPDF6_INC
  GENIE_OTHER_EXT_INCLUDES += -I$(GOPT_WITH_LHAPDF6_INC)
endif

# additional GENIE/Generator libraries
GENIE_LIBRARIES = $(shell genie-config --libs)

# additional GENIE/Reweight libraries
# (hack while GENIE_REWEIGHT independent package is not good at reporting its own libraries)
ifdef GENIE_REWEIGHT
   GENIE_LIBRARIES += -L$(GENIE_REWEIGHT)/lib -lGRwFwk -lGRwClc -lGRwIO
endif

# additional ROOT libraries needed with GENIE
ROOT_LIBRARIES += -lEGPythia6 -lGeom -lGenVector

# additional VALOR libraries that use GENIE
ifeq ("false",$(is_cln))
  VALOR_FMWK_LIBRARIES += $(shell valor_fmwk-config --glibs)
endif

# other ext libraries needed for GENIE
GENIE_OTHER_EXT_LIBRARIES =
ifdef GOPT_WITH_PYTHIA6_LIB
  GENIE_OTHER_EXT_LIBRARIES += -L$(GOPT_WITH_PYTHIA6_LIB) -lPythia6
endif
ifdef GOPT_WITH_PYTHIA8_LIB
# blah
endif
ifdef GOPT_WITH_LHAPDF5_LIB
# blah
endif
ifdef GOPT_WITH_LHAPDF6_LIB
  GENIE_OTHER_EXT_LIBRARIES += -L$(GOPT_WITH_LHAPDF6_LIB) -lLHAPDF
endif

endif # OPT_ENABLE_GENIE

# hack for the FNAL UPS approach
ifdef GENIE_FQ_DIR
  GENIE_INCLUDES += -I$(GENIE_FQ_DIR)/include/GENIE/
endif

#-------------------------------------------------------------------
#                   PROFILING / DEBUGING OPTIONS
#-------------------------------------------------------------------
# Linking in the Google Profiling Tool library
#
#GPROF_LIBRARIES = 
#ifeq ($(strip $(OPT_ENABLE_PROFILER)),YES)
#  ifdef OPT_WITH_PROFILER_LIB
#    GPROF_LIBRARIES += -L$(OPT_WITH_PROFILER_LIB) -lprofiler
#  else
#    GPROF_LIBRARIES += -L/usr/local/lib -lprofiler
#  endif
#endif
#

#-------------------------------------------------------------------
#                       Some global variables
#-------------------------------------------------------------------
MAKE   := make
RM      = rm -f
MKDIR   = mkdir -p
CAT     = cat
SYMLINK = ln -sf
COPY    = cp
INSTALL = @INSTALL@

# AR, ARFLAGS and RANLIB are for manipulating an archive
AR        = ar
ARFLAGS   = rv
RANLIB    = ranlib

#-------------------------------------------------------------------
#                        COMPILER OPTIONS
#-------------------------------------------------------------------

ifeq ($(OPT_WITH_COMPILER),$(filter $(OPT_WITH_COMPILER),clang clang++))
  # --clang
  CXX           = clang++
  CC            = clang
  LD            = clang++
else ifeq ($(OPT_WITH_COMPILER),$(filter $(OPT_WITH_COMPILER),gcc g++))
  # -- gcc
  CXX = g++
  CC  = gcc
  LD  = g++
else
  $(error OPT_WITH_COMPILER not set correctly!)
endif

#check if we're using clang (complicated because g++ is sometimes a clang alias...)
APPLE_CLANG := $(shell $(CXX) -v 2>&1 | sed -n "s/.*clang//p" | cut -d . -f 1)
ifneq ($(APPLE_CLANG),)
USING_CLANG  = YES
endif

# get gcc version & split in '.' delimited tokens (major/minor/revison num.)
CXXVRS      = $(shell $(CXX) -dumpversion)
CXXVRS_MAJ  = $(shell awk 'BEGIN {\
		str="$(CXXVRS)"; split(str, tk, "."); print tk[1]}')
CXXVRS_MIN  = $(shell awk 'BEGIN {\
		str="$(CXXVRS)"; split(str, tk, "."); print tk[2]}')
CXXVRS_REV  = $(shell awk 'BEGIN {\
		str="$(CXXVRS)"; split(str, tk, "."); print tk[3]}')
		
ifeq ($(CXXVRS_MIN),)
  CXXVRS_MIN = 0
endif


# gcc version >= 4.1.0 ?
GCC_GE_4_1_0  = $(shell awk 'BEGIN {\
		if($(CXXVRS_MAJ)>=4 && $(CXXVRS_MIN)>0) print "YES"}')
# gcc version >= 4.2.1 ?
GCC_GE_4_2_1  = $(shell awk 'BEGIN {\
		if($(CXXVRS_MAJ)>=4 && $(CXXVRS_MIN)>0 && $(CXXVRS_REV)>=0) print "YES"}')

# MAC OS X with gcc, 32-bit mode
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ifeq ($(strip $(ARCH)),macosx) 
ARCH_OK       = YES
IS_MACOSX     = YES
CCFLAGS      = -pipe \
		-fsigned-char -fno-common -flat_namespace \
		$(ROOT_FLAGS) \
		$(OPT_WITH_CXX_DEBUG_FLAG) \
		$(OPT_WITH_CXX_OPTIMIZ_FLAG) \
		$(OPT_WITH_CXX_VERSION_FLAG) \
		$(OPT_WITH_CXX_USERDEF_FLAGS) \
		$(OPT_WITH_CXX_MISC_FLAGS)
CXXFLAGS      = $(CCFLAGS) -W -Wall -Wno-long-double
ifeq ($(strip $(GCC_GE_4_1_0)), YES) 
  CXXFLAGS += -Wno-strict-aliasing 
endif
ifneq ($(USING_CLANG), YES)
  CXXFLAGS += -flat_namespace
endif
LDFLAGS       = -bind_at_load
SOFLAGS       = -dynamiclib -flat_namespace \
		-single_module -undefined dynamic_lookup
DllSuf       := dylib
DllLinkSuf   := so
StaticLibSuf := a
ObjSuf       := o
SrcSuf       := cxx
FORT         := g77
FORTOPTS     := $(FFLAGS) -g -c -O -DLINUX $(F77INCS) -fno-second-underscore
RANLIB       := ranlib
SOCMD         = $(LD)
OutPutOpt     = -o
SOMINF        =
EXTRALIBS     = 
endif

# MAC OS X with gcc, 64-bit mode
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ifeq ($(strip $(ARCH)),macosx64) 
OSX_VERSION = $(shell sw_vers | grep 'ProductVersion:' | grep -o '[0-9]*\.[0-9]*\.[0-9]*')  
OSXVRS_MAJ  = $(shell awk 'BEGIN {\
		str="$(OSX_VERSION)"; split(str, tk, "."); print tk[1]}')
OSXVRS_MIN  = $(shell awk 'BEGIN {\
		str="$(OSX_VERSION)"; split(str, tk, "."); print tk[2]}')
OSXVRS_REV  = $(shell awk 'BEGIN {\
		str="$(OSX_VERSION)"; split(str, tk, "."); print tk[3]}')
# osx version >= 10.6 ?
OSX_GE_10_6_0  = $(shell awk 'BEGIN {\
		if($(OSXVRS_MAJ)>=10 && $(OSXVRS_MIN)>=6) print "YES"}')
# osx version >= 10.9 ?
OSX_GE_10_9_0  = $(shell awk 'BEGIN {\
		if($(OSXVRS_MAJ)>=10 && $(OSXVRS_MIN)>=9) print "YES"}')
ARCH_OK       = YES
IS_MACOSX     = YES
CCFLAGS      = -m64 -pipe \
		-fsigned-char -fno-common  \
		$(ROOT_FLAGS) \
		$(OPT_WITH_CXX_DEBUG_FLAG) \
		$(OPT_WITH_CXX_OPTIMIZ_FLAG) \
		$(OPT_WITH_CXX_VERSION_FLAG) \
		$(OPT_WITH_CXX_USERDEF_FLAGS) \
		$(OPT_WITH_CXX_MISC_FLAGS)
CXXFLAGS      = $(CCFLAGS) -Wshadow -W -Wall -Wno-overloaded-virtual
ifneq ($(strip $(GCC_GE_4_2_1)), YES) 
  ifneq ($(USING_CLANG), YES)
    CXXFLAGS   += -flat_namespace
  endif
endif
ifeq ($(GCC_GE_4_1_0),YES)
  ifeq ($(USING_CLANG),YES)
    ifeq ($(OSX_GE_10_9_0),YES)
      CXXFLAGS += -stdlib=libc++ -mmacosx-version-min=10.9
    else ifeq ($(OSX_GE_10_6_0),YES)
      CXXFLAGS += -stdlib=libstdc++ -mmacosx-version-min=10.6
    endif
  endif
  CXXFLAGS += -Wno-strict-aliasing
endif
LDFLAGS       = -bind_at_load
SOFLAGS       = -dynamiclib \
		-single_module -undefined dynamic_lookup
ifneq ($(strip $(GCC_GE_4_2_1)), YES) 
  SOFLAGS    += -flat_namespace
endif
DllSuf       := dylib
DllLinkSuf   := so
StaticLibSuf := a
ObjSuf       := o
SrcSuf       := cxx
FORT         := g77
FORTOPTS     := $(FFLAGS) -g -c -O -DLINUX $(F77INCS) -fno-second-underscore
RANLIB       := ranlib
SOCMD         = $(LD)
OutPutOpt     = -o
SOMINF        =
EXTRALIBS     = 
endif

# LINUX / 32-bit x86 / with gcc
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ifeq ($(strip $(ARCH)),linux) 
ARCH_OK       = YES
CCFLAGS      = -fPIC \
		$(ROOT_FLAGS) \
		$(OPT_WITH_CXX_DEBUG_FLAG) \
		$(OPT_WITH_CXX_OPTIMIZ_FLAG) \
		$(OPT_WITH_CXX_VERSION_FLAG) \
		$(OPT_WITH_CXX_USERDEF_FLAGS)  \
		$(OPT_WITH_CXX_MISC_FLAGS)
CXXFLAGS      = $(CCFLAGS) -Wshadow -W -Wall 
ifeq ($(strip $(GCC_GE_4_1_0)), YES) 
  CXXFLAGS += -Wno-strict-aliasing 
endif
LDFLAGS       = $(OPT_WITH_CXX_DEBUG_FLAG) -Wl,--no-as-needed -ldl
SOFLAGS       = $(OPT_WITH_CXX_DEBUG_FLAG) -shared
DllSuf       := so
DllLinkSuf   := 
StaticLibSuf := a
ObjSuf       := o
SrcSuf       := cxx
FORT         := g77
FORTOPTS     := $(FFLAGS) -g -c -O -DLINUX $(F77INCS) -fno-second-underscore
RANLIB       := ranlib
SOCMD         = $(LD)
OutPutOpt     = -o
SOMINF        =
EXTRALIBS     = -lnsl
endif

# LINUX / 64-bit x86 / with gcc
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ifeq ($(strip $(ARCH)),linuxx8664gcc) 
ARCH_OK       = YES
CCFLAGS      = -fPIC \
		$(ROOT_FLAGS) \
		$(OPT_WITH_CXX_DEBUG_FLAG) \
		$(OPT_WITH_CXX_OPTIMIZ_FLAG) \
		$(OPT_WITH_CXX_VERSION_FLAG) \
		$(OPT_WITH_CXX_USERDEF_FLAGS)  \
		$(OPT_WITH_CXX_MISC_FLAGS)
CXXFLAGS      = $(CCFLAGS) -Wall -Wextra -Wshadow 
ifeq ($(strip $(GCC_GE_4_1_0)), YES) 
  CXXFLAGS += -Wno-strict-aliasing 
endif
LDFLAGS       = $(OPT_WITH_CXX_DEBUG_FLAG) $(OPT_WITH_CXX_MISC_FLAGS) -Wl,--no-as-needed
SOFLAGS       = $(OPT_WITH_CXX_DEBUG_FLAG) $(OPT_WITH_CXX_MISC_FLAGS) -shared
DllSuf       := so
DllLinkSuf   := 
StaticLibSuf := a
ObjSuf       := o
SrcSuf       := cxx
FORT         := g77
FORTOPTS     := $(FFLAGS) -g -c -O -DLINUX $(F77INCS) -fno-second-underscore
RANLIB       := ranlib
SOCMD         = $(LD)
OutPutOpt     = -o
SOMINF        =
EXTRALIBS     = -lnsl
endif

#-------------------------------------------------------------------
#                            SUMMING-UP
#-------------------------------------------------------------------

# includes and libraries needed to compile programs. 

INCLUDES  := $(VALOR_INCLUDES) \
             $(GENIE_INCLUDES) \
             $(LOG_INCLUDES) \
             $(ROOT_INCLUDES) \
             $(GSL_INCLUDES) \
             $(GENIE_OTHER_EXT_INCLUDES) \
             $(LINUX_SYS_INCLUDES)

LIBRARIES := $(SYSLIBS) \
	     $(VALOR_APP_LIBRARIES) \
	     $(VALOR_FMWK_LIBRARIES) \
             $(GENIE_LIBRARIES) \
	     $(LOG_LIBRARIES) \
	     $(ROOT_LIBRARIES) \
	     $(GPROF_LIBRARIES) \
	     $(GSL_LIBRARIES) \
             $(GENIE_OTHER_EXT_LIBRARIES) \
	     $(OPT_WITH_MISC_LIBS)

# Default compiler and preprocessor flags

CXXFLAGS := $(ENV_CXXFLAGS) $(CXXFLAGS)
CPPFLAGS  = $(INCLUDES)
CFLAGS    = $(OPT_WITH_CXX_DEBUG_FLAG)

#-------------------------------------------------------------------
#                            MAKE RULES
#-------------------------------------------------------------------

.SUFFIXES : .inc .cxx

#.cc.o:
#	$(CXX) -c -o $@ $(CXXFLAGS) $(CPPFLAGS) $<

#.cxx.o:
#	$(CXX) -c -o $@ $(CXXFLAGS) $(CPPFLAGS) $<

.cc.o:
	$(CXX) -c $(CCFLAGS) $(CPPFLAGS) $<

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(CPPFLAGS) $<

.C.o:
	$(CXX) -c -o $@ $(CXXFLAGS) $(CPPFLAGS) $<

.c.o:
	$(CC) -c -o $@ $(CXXFLAGS) $(CPPFLAGS) $<

.F.o :
	$(FORT) $(FORTOPTS) -o $@ $<

.f.o :
	$(FORT) $(FORTOPTS) -o $@ $<

.F.a :
	$(FORT) $(FORTOPTS) -o $*.o $<
	$(AR) $(ARFLAGS) $@ $*.o
	$(RANLIB) $@
	$(RM) $*.o

.f.a :
	$(FORT) $(FORTOPTS) -o $*.o $<
	$(AR) $(ARFLAGS) $@ $*.o
	$(RANLIB) $@
	$(RM) $*.o

# Print variable name for debugging MakeFile, eg make print-INCLUDES
print-%  : ; @echo $* = $($*)

