#!/bin/sh
# -*- sh-indentation: 3 -*-
#
# valor_fmwk-config a la ROOT's root-config
#

# VALOR/FMWK top directory path:
topdir=$VALOR_FMWK

# VALOR/FMWK libraries path:
libdir=$VALOR_FMWK/lib

# VALOR/FMWK src top level directory:
srcdir=$VALOR_FMWK/src

# VALOR/FMWK libraries:
libs="-L$libdir -lValorMesg -lValorArray -lValorNtuple -lValorRegistry -lValorConv -lValorUtil -lValorDerivedUtil -lValorOsc -lValorCmdLine -lValorFitCore"

#
# Usage
#

usage="\
Usage: valor_fmwk-config [--libs] [--libdir] [--srcdir] [--topdir]" 

if test $# -eq 0; then
   echo "${usage}" 1>&2
   exit 1
fi

out=""

while test $# -gt 0; do
  case "$1" in
  -*=*) optarg=`echo "$1" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
  *)    optarg= ;;
  esac

  case $1 in
    --topdir)
      out="$out $topdir"
      ;;
    --libdir)
      out="$out $libdir"
      ;;
    --srcdir)
      out="$out $srcdir"
      ;;
    --libs)
      out="$out $libs"
      ;;
  esac
  shift
done

echo $out
