#! /usr/bin/perl -w
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# VALOR/FMWK configuration script
#
# For help, type ./configure --help
#
# Costas Andreopoulos <costas.andreopoulos \at stfc.ac.uk>
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# print out info & exit if any of the command-line arguments was --help
#
if(($match = grep(/--help/i, @ARGV)) > 0) { 
  print "\n";
  print "*** VALOR/FMWK configure script *** \n\n";
  print "Usage: ./configure [option]... [flag=value]... \n\n";
  print "    FLAG              DESCRIPTION                                                 DEFAULT\n\n";
  print "    --prefix          installation location (for 'make install')                  /usr/local/\n";
  print "\n enable/disable options with either --enable- or --disable- (eg --enable-lhapdf --disable-flux-drivers)\n\n";
  print "    debug             Adds -g in the compiler options to request debug info       default: disabled \n";
  print "    gsl               Enables GSL fitters. Requires ROOT MathMore library         default: enabled if MathMore available \n";
  print "    asan              Build and link against AddressSanitizer.                    default: disabled \n";
  print "\n options for 3rd party software, prefix with --with- (eg --with-lhapdf-lib=/some/path/)\n\n";
  print "    optimiz-level     Compiler optimization (any of O,O2,O3,OO,Os)                default: O2 \n";
  print "    log4cpp-inc       Path to log4cpp includes                                    default: - (auto-detection enabled) \n";
  print "    log4cpp-lib       Path to log4cpp library                                     default: - (auto-detection enabled) \n";
  print "    compiler          Compiler to use (any of clang,g++)                          default: g++ \n";
  print "If the printout was too long then pipe it through a pager, eg: \n";
  print "./configure --help | more \n";
  exit 0;
}

# Check that $VALOR_FMWK is set
#
$VALOR_FMWK = $ENV{'VALOR_FMWK'};
die ("*** Error *** The VALOR_FMWK environmental variable is not defined") 
unless defined $VALOR_FMWK;

# Check that $ROOTSYS is set
#
$ROOTSYS = $ENV{'ROOTSYS'};
die ("*** Error *** The ROOTSYS environmental variable is not defined. Is ROOT installed?") 
unless defined $ROOTSYS;

# Enable auto-detection?
#
system("find $VALOR_FMWK/configure");
print "\n";
$auto_detect = ($?==0) ? 1 : 0;
if(! $auto_detect) {
  print "\n*** Warning *** Path auto-detection is turned off. You need the 'find' utility to use that feature\n\n";
}

print "\nYour input configuration options were: @ARGV";
if($#ARGV < 0) { print "(none)" };
print "\n\n";

# Print VALOR/FMWK banner 
#
$BANNER_FILE = "$VALOR_FMWK/data/banner/banner.dat";
if(-e $BANNER_FILE) {
  open(BANNER, "<$BANNER_FILE");
  @hdr=<BANNER>;
  print @hdr;
  close(BANNER);
  print "\n";
}

# 
# Process inputs
# 

# Create a string by joining all the command line arguments
#
my $options = join(" ", @ARGV);

# Get & save installation location (--prefix) or set default
#
my $opt_prefix="/usr/local/";
if(($match = grep(/--prefix/i, @ARGV)) > 0) { 
  $options=~m/--prefix=(\S*)/i;
  $opt_prefix = $1;
  if( $VALOR_FMWK eq $opt_prefix ) {
     print "*** Error *** --prefix can not point to the VALOR_FMWK top level directory!\n\n";
     exit 1;
  }
}

# Check compiler
#
my $opt_with_compiler="g++"; # default
if( $options=~m/--with-compiler=(\S*)/i ) {
  $opt_with_compiler = $1;
}

# Default --enable/--disable config options (for a minimal build)
#
my $opt_enable_debug      = "NO";
my $opt_enable_gsl        = "NO";
my $opt_enable_asan       = "NO";

# Check configure's command line arguments for non-default values
#
if(($match = grep(/--enable-debug/i,   @ARGV)) > 0) { $opt_enable_debug  = "YES"; }
if(($match = grep(/--enable-gsl/i,     @ARGV)) > 0) { $opt_enable_gsl    = "YES"; }
if(($match = grep(/--enable-asan/i,    @ARGV)) > 0) { $opt_enable_asan   = "YES"; }

# Just enable GSL if available
if (`root-config --features` =~ m/mathmore/) { $opt_enable_gsl    = "YES"; }

my $opt_with_cxx_debug_flag="";
if($opt_enable_debug eq "YES") { $opt_with_cxx_debug_flag = "-g"; }

my $opt_with_cxx_misc_flags="";
my $opt_with_cxx_misc_libs ="";
if($opt_enable_asan eq "YES") {
  $opt_with_cxx_misc_flags .= "-fsanitize=address -fno-omit-frame-pointer ";
  $compiler_vers = `$opt_with_compiler --version`;
  if ($compiler_vers!~"LLVM") {
    $opt_with_cxx_misc_libs  .= "-lasan ";
  }
}


# Check compiler optimization level
#
my $opt_with_cxx_optimiz_flag="O2"; # default
if( $options=~m/--with-optimiz-level=(\S*)/i ) {
  $opt_with_cxx_optimiz_flag = $1;
}

#
# Get libxml2 and log4cpp include and library paths
#

my $opt_with_log4cpp_inc = "";
my $opt_with_log4cpp_lib = "";

# --with-log4cpp-inc=
if($options=~m/--with-log4cpp-inc=(\S*)/i) {
  $opt_with_log4cpp_inc = $1;
}
if(! -d $opt_with_log4cpp_inc && $auto_detect)  {
  print "\n*** Warning *** You didn't specify the log4cpp include path \n";
  print "Auto-detecting...\n";
  $matched = auto_detect("OstreamAppender.hh");
  if( $matched=~m/(\S*)\/log4cpp\/OstreamAppender.hh/i ) {
     $opt_with_log4cpp_inc = $1;
  }
  print "Setting --with-log4cpp-inc=$opt_with_log4cpp_inc\n";
}
if(! -d $opt_with_log4cpp_inc) {
  print "*** Error *** You need to specify the log4cpp include path using --with-log4cpp-inc=/some/path/\n\n";
  exit 1;
}

# --with-log4cpp-lib=
if($options=~m/--with-log4cpp-lib=(\S*)/i) {
  $opt_with_log4cpp_lib = $1;
}
if(! -d $opt_with_log4cpp_lib && $auto_detect)  {
  print "\n*** Warning *** You didn't specify the log4cpp library path \n";
  print "Auto-detecting...\n";
  $matched = auto_detect("liblog4cpp.*");
  if( $matched=~m/(\S*)\/liblog4cpp\S*/i ) {
     $opt_with_log4cpp_lib = $1;
  }
  print "Setting --with-log4cpp-lib=$opt_with_log4cpp_lib\n";
}
if(! -d $opt_with_log4cpp_lib) {
  print "*** Error *** You need to specify the log4cpp library path using --with-log4cpp-lib=/some/path/\n\n";
  exit 1;
}

print "\n";

# 
# Read version info and automatically generate a header file with relevant flags that
# can be used to make code conditional upon specific version numbers
#
$VRS_FILENAME = "$VALOR_FMWK/VERSION";
open(VRS_FILE, "<$VRS_FILENAME") or die("Can not read the VALOR_FMWK version information!");
@vrs_file=<VRS_FILE>;
close(VRS_FILE);
chomp($release = $vrs_file[0]);
# ($major, $minor, $rev) = split('.', $release);
# note: split() doesn't split on dots...
$release=~m/(\d+).(\d+).(\d+)/;
$major = $1;
$minor = $2;
$revis = $3;
$VRS_HEADER_FILENAME = "$VALOR_FMWK/src/valor/Conventions/Version.h";
print "Automatically generating file: $VRS_HEADER_FILENAME \n";
open(VRS_HEADER_FILE, ">$VRS_HEADER_FILENAME") or die("Can not write out the Version.h file!");
print VRS_HEADER_FILE "#ifndef _VALOR_FMWK_VERSION_H_ \n";
print VRS_HEADER_FILE "#define _VALOR_FMWK_VERSION_H_ \n";
print VRS_HEADER_FILE "/* \n";
print VRS_HEADER_FILE " * Version information automatically generated by the VALOR/FMWK installer \n";
print VRS_HEADER_FILE " * \n";
print VRS_HEADER_FILE " * These macros can be used in the following way (as the ones at ROOT's RVersion.h): \n";
print VRS_HEADER_FILE " * #if __VALOR_FMWK_RELEASE_CODE__ >= GRELCODE(2,4,11) \n";
print VRS_HEADER_FILE " * #include <newheader.h>\n";
print VRS_HEADER_FILE " * #else\n";
print VRS_HEADER_FILE " * #include <oldheader.h>\n";
print VRS_HEADER_FILE " * #endif\n";
print VRS_HEADER_FILE "*/ \n\n";
print VRS_HEADER_FILE "#define VALOR_FMWK_RELEASE_CODE_BUILDER(a,b,c) (((a) << 16) + ((b) << 8) + (c)) \n\n";
print VRS_HEADER_FILE "#define __VALOR_FMWK_RELEASE__      \"$release\"\n";
print VRS_HEADER_FILE "#define __VALOR_FMWK_RELEASE_CODE__ VALOR_FMWK_RELEASE_CODE_BUILDER($major,$minor,$revis) \n\n";
print VRS_HEADER_FILE "#endif\n\n";
close(VRS_HEADER_FILE);

# 
# Automatically generate a header file with relevant build information that
# can be used to make code conditional upon it
#
$BLD_HEADER_FILENAME = "$VALOR_FMWK/src/valor/Conventions/Build.h";
print "Automatically generating file: $BLD_HEADER_FILENAME \n";
open(BLD_HEADER_FILE, ">$BLD_HEADER_FILENAME") or die("Can not write out the Build.h file!");
print BLD_HEADER_FILE "#ifndef _VALOR_FMWK_BUILD_H_ \n";
print BLD_HEADER_FILE "#define _VALOR_FMWK_BUILD_H_ \n";
print BLD_HEADER_FILE "/* \n";
print BLD_HEADER_FILE " * Version information automatically generated by the VALOR/FMWK installer \n";
print BLD_HEADER_FILE " */ \n\n";
# GSL info
if($opt_enable_gsl eq "YES") { 
  print BLD_HEADER_FILE   "#define __VALOR_FMWK_GSL_ENABLED__\n"; 
} else {
  print BLD_HEADER_FILE "//#define __VALOR_FMWK_GSL_ENABLED__\n"; 
}
# Debug info
if($opt_enable_debug eq "YES") { 
  print BLD_HEADER_FILE   "#define __VALOR_FMWK_DEBUG_ENABLED__\n"; 
} else {
  print BLD_HEADER_FILE "//#define __VALOR_FMWK_DEBUG_ENABLED__\n"; 
}
# grab log4cpp version information
open(LOG4CPP_FILE, "$opt_with_log4cpp_inc/log4cpp/config.h") or warn("$opt_with_log4cpp_inc/log4cpp/config.h!");
$log4cpp_vrs_set = 0;
foreach(<LOG4CPP_FILE>) {
  chomp $_;
# print "$_\n";
  if(m/\Wdefine\s+LOG4CPP_VERSION\s+.(\d+).(\d+)./i) {
      $log4cpp_vrs = 0;
      if($1 >0 ) { $log4cpp_vrs = $1 * 100 + $2; }
#     print "VALOR/FMWK seems to be using log4cpp version $log4cpp_vrs \n";
      print BLD_HEADER_FILE  "#define __VALOR_FMWK_USES_LOG4CPP_VERSION__ $log4cpp_vrs \n";
      $log4cpp_vrs_set = 1;
  }
}
if($log4cpp_vrs_set==0) {
  print BLD_HEADER_FILE "//#define __VALOR_FMWK_USES_LOG4CPP_VERSION__ <unknown> \n";
}
close LOG4CPP_FILE;
print BLD_HEADER_FILE "\n\n";
print BLD_HEADER_FILE "#endif\n\n";
close(BLD_HEADER_FILE);


#
# Save config options to src/make/Make.config for inclusion in other Makefiles
#
# Open Make.config to write configuration options
#
$MKCONF_FILENAME = "$VALOR_FMWK/make/Make.config";
print "Automatically generating file: $MKCONF_FILENAME \n";
open(MKCONF, ">$MKCONF_FILENAME") or die("Can not write out the Make.config file!");
print MKCONF "# \n";
print MKCONF "# Make.config \n";
print MKCONF "# This file was automatically generated by the VALOR/FMWK installer \n";
print MKCONF "# for inclusion into the project Makefiles  \n";
print MKCONF "# \n";
print MKCONF "OPT_PREFIX=$opt_prefix\n";
print MKCONF "OPT_WITH_CXX_DEBUG_FLAG=$opt_with_cxx_debug_flag\n";
print MKCONF "OPT_WITH_CXX_OPTIMIZ_FLAG=-$opt_with_cxx_optimiz_flag\n";
print MKCONF "OPT_WITH_CXX_MISC_FLAGS=$opt_with_cxx_misc_flags\n";
print MKCONF "OPT_WITH_MISC_LIBS=$opt_with_cxx_misc_libs\n";
print MKCONF "OPT_ENABLE_GSL=$opt_enable_gsl\n";
print MKCONF "OPT_WITH_LOG4CPP_INC=$opt_with_log4cpp_inc\n";
print MKCONF "OPT_WITH_LOG4CPP_LIB=$opt_with_log4cpp_lib\n";
print MKCONF "OPT_WITH_COMPILER=$opt_with_compiler\n";
close(MKCONF);
if(-e $MKCONF_FILENAME) {
  print "\nThe following config options were set in Make.config: \n";
  open(MKCONFR, "<$MKCONF_FILENAME") or die("Can not read back the $VALOR_FMWK/src/make/Make.config!");
  @make_conf=<MKCONFR>;
  close(MKCONFR);
# print "@make_conf\n" unless ;
  foreach $setting (@make_conf) { 
    chomp($setting); 
    if ($setting=~m/\=/) {print "  $setting\n";} 
  }
  print "\n";
  print "*** To continue building VALOR/FMWK type: make ";
  # Warning for SRT users  
  if(defined $ENV{'SRT_ENV_SET'}) {
    print "(Don't forget to 'srt_setup --unsetup' first)";
  }
  print "\n\n";
}

sub auto_detect {
  
  # First place to look when autodetecting is in the directories in LD_LIBRARY_PATH
  my @libdirs  = split(":",$ENV{LD_LIBRARY_PATH});
  push (@libdirs,split(":",$ENV{DYLD_LIBRARY_PATH})); #and the mac equivalent
  my @search_dir = ();
  foreach my $libdir (unique_entries(@libdirs)) {
    chomp($libdir);
    if (not $libdir) {next;}
    push (@search_dir, $libdir); # Append the LD library path directory
    @pathdirs = split("/",$libdir);
    $lastdir = pop(@pathdirs);
    $basedir = join("/",@pathdirs);
    if ($lastdir =~ m/lib/) {# If the LD_LIBRARY_PATH has "lib" in it, append "../include"
      push (@search_dir, $basedir."/include"); 
    }
  }
  push (@search_dir,"/usr");                        # Add usr
  push (@search_dir,"/lib");                        # Add opt 
  push (@search_dir,"/opt");                        # Add opt 
  push (@search_dir,"$ENV{'HOME'}") 
                 if defined $ENV{'HOME'};          # add $HOME
  push (@search_dir,"/hep");                       # add where I add ext apps in my mac book air
  push (@search_dir,"$ENV{'RSD_TOP_DIR'}") 
                 if defined $ENV{'RSD_TOP_DIR'};   # add where RSD puts ext supporting libs
  
  @search_dir = unique_entries(@search_dir); # Search each dir only once
    
  $search_file = shift; 
  $optional_fullpath_substr = shift; # extra help in locating the correct file

  $optional_fullpath_substr = "" unless defined $optional_fullpath_substr;

  foreach(@search_dir) {
     $curr_dir = $_;
     if(! -d $curr_dir) {next;}
     @matches = `find $curr_dir/ -type f -maxdepth 7 -name \"$search_file\" 2> /dev/null | grep \"$optional_fullpath_substr\"`;
     $nmatches = @matches;
     if( $nmatches > 0) { return $matches[0]; }
  }
  return "";
}

# Get unique entries in an array
sub unique_entries {
  my %seen;
  return grep { !$seen{$_}++ } @_;
}
