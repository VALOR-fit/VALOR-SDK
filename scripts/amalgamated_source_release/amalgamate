#!/usr/bin/perl

$valor_fmwk_top_dir = $ENV{"VALOR_FMWK"};

$list_of_includes = "./lists/headers_needed.txt";
$list_of_valor_source_files = "./lists/valor_source_files_needed_for_t2k.txt";

# Add includes
system("cat $list_of_includes >> valor.cxx.tmp~1");

# Read list of VALOR source file to bundle
open my $SOURCE_FILE_LIST, '<', $list_of_valor_source_files;
chomp(my @valor_files = <$SOURCE_FILE_LIST>);
close $SOURCE_FILE_LIST;

# Add VALOR header files
foreach(@valor_files) {
  if(/.h$/) {
    $valor_file = $valor_fmwk_top_dir . "/" . $_;
    print "Adding: $valor_file \n";
    system("cat $valor_file | grep -v '^#' | grep -v '^//' | grep -v '^using' >> valor.cxx.tmp~1");
  }
}
# Add VALOR implementation files
foreach(@valor_files) {
  if(/.cxx$/) {
    $valor_file = $valor_fmwk_top_dir . "/" . $_;
    print "Adding: $valor_file \n";
    system("cat $valor_file | grep -v '^#' | grep -v '^//' | grep -v '^using' >> valor.cxx.tmp~1");
  }
}

# Remove all comments
system("./remove_comments.sed < valor.cxx.tmp~1 > valor.cxx.tmp~2");

# Remove all empty lines and destroy C++ indentation
system("sed -f remove_spaces.sed valor.cxx.tmp~2 > valor.cxx.tmp~3");

#
# system("sed -e /^$/d out2.tmp > out3.tmp");

#
system("cp valor.cxx.tmp~3 valor.cxx");
