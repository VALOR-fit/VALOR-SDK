#!/usr/bin/perl
#
#-------------------------------------------------------------------------------------------------------------------------------
# Fetch VALOR data.
# See the README file for the VALOR data archive directory structure.
#
# Inputs:
#     --data-resource : Remote data archive
#                       In the original implementation, this was a standard URL (http(s)://hostname/some/path) passed to wget.
#                       In a subsequent revision, as large disk spaces accessible via http became increasingly scarce, I added
#                       the option to specify a resource as username://machine/some/path so that files can be obtained with scp.
#    [--local-path]   : Local path for downloading the VALOR inputs to. [Default: .]
#     --data-major    : Major qualifier for a set of VALOR inputs.
#    [--data-minor]   : Major qualifier for a set of VALOR inputs. Wildcards allowed. [Default: *]
#    [--data-revis]   : Revision qualifier for a set of VALOR inputs. Wildcards allowed. [Default: *]
#    [--rm-obsolete]  : Obsolete files are automatically renamed (appending "~date_time" in the filename) and they are
#                       not overwritten. Add this option if you prefer to have them removed.
#    [--debug]        : Add this option to get additional print-out for debugging / diagnosing problems.
#
# Note:
# * The existence of a checksum file in the data archive is required for each the `major/minor/revision' combination
#   of qualifiers for any set of inputs that can be fetched.
# * The --data-minor and --data-revis arguments can accept a wildcard.
#   For example, one could fetch `dune/ndfit/2017a' and `dune/fdfit/2017a' in two steps, or fetch all inputs required
#   for the 2017a DUNE joint analysis (`dune/*/2017a') in one step. Or, one could fetch all 2016a, 2016b and 2016c versions
#   of the DUNE near detector analysis by specifying `dune/ndfit/2016*'
#
# TODO:
#
# * Implement a --purge option to clean up local copy, removing automatically renamed obsolete files as well as files
#   that were removed from the archive
#
# Examples:
# ---------
#
# 1) Assume the existence of a data product with major qualifier `sbn_simulation_inputs' that includes
#    several sub-products with minor qualifiers `sbnd_geometry', `sbnd_flux' etc.
#    Assume that data are accessible via http from https://valor.pp.rl.ac.uk/some/hypothetical/data/storage/
#    To access the `2020a' revision of the SBND geometry, one should type:
#
#    % valor_data-fetch --data-major sbn_simulation_inputs --data-minor sbnd_geometry --data-revis 2020a
#                       --data-resource  https://valor.pp.rl.ac.uk/some/hypothetical/data/storage/
#
# 2) Assume that you want to obtain the same data product listed above, but the data are not accessible via http.
#    Instead, they should be obtained from the /hepstore/neutrino/data directory at the Liverool HEP machines.
#    The previous example becomes
#
#    % valor_data-fetch --data-major sbn_simulation_inpuys --data-minor sbnd_geometry --data-revis 2020a
#                       --data-resource  costas@gateway.ph.liv.ac.uk:/hepstore/neutrino1/data_archive/
#
#    Obviously, use your own username.
#    For the above example to work, you will be asked to type in your SSH key passphrase.
#
# C. Andreopoulos <constantinos.andreopoulos@cern.ch>
# University of Liverpool & STFC/RAL
#-------------------------------------------------------------------------------------------------------------------------------
#

use Term::ANSIColor;
use Term::ANSIColor qw(:constants);
use File::Path;
use File::Basename;

$iarg=0;
foreach (@ARGV) {
  if   ($_ eq '--data-resource') { $data_resource  = $ARGV[$iarg+1]; }
  elsif($_ eq '--local-path'   ) { $local_base_dir = $ARGV[$iarg+1]; }
  elsif($_ eq '--data-major'   ) { $data_major_q   = $ARGV[$iarg+1]; }
  elsif($_ eq '--data-minor'   ) { $data_minor_q   = $ARGV[$iarg+1]; }
  elsif($_ eq '--data-revis'   ) { $data_revis_q   = $ARGV[$iarg+1]; }
  elsif($_ eq '--rm-obsolete'  ) { $rm_obsolete    = 1; }
  elsif($_ eq '--debug'        ) { $debug_output   = 1; }
  $iarg++;
}
die("VALOR: Please provide an input for --data-major") unless defined $data_major_q;

$local_base_dir  = "." unless defined $local_base_dir;
$data_minor_q    = "*" unless defined $data_minor_q;
$data_revis_q    = "*" unless defined $data_revis_q;
$rm_obsolete     = 0   unless defined $rm_obsolete;
$debug_output    = 0   unless defined $debug_output;

print "\n\n";
print BOLD, YELLOW, "VALOR: Will fetch the data product(s) with [major qualifier: $data_major_q / minor qualifier: $data_minor_q / revision qualifier: $data_revis_q] data to $local_path\n", RESET;
if($rm_obsolete == 1) {
  print BOLD, RED, "VALOR: ** Note that obsolete data will be removed from the local system ** \n\n", RESET;
}

$use_wget = 0;
$use_scp  = 0;
if($data_resource =~ m/http/i) {
  $use_wget = 1;
} else {
  $use_scp = 1;
  print BOLD, CYAN, "\nVALOR: Enter your ssh key passphrase so as to access the data resource at: $data_resource \n", RESET;
  system("ssh-add");
}

# Remove a trailing `/' from $data_resource, if any, because when a "/data/Expt/Component/Version"
# is appended, the resulting double `//' interferes with the correct calculation of the
# appropriate argument for the wget --cut-dirs option.
# The regex below also works for multiple trailing `/'s.
$data_resource_no_trailing_slash = $1 if($data_resource =~ m/^(.*?)\/*$/);
# $archive_url_no_trailing_slash = $1 if($archive_url =~ m/^(.*?)\/*$/);
print "VALOR: Removed trailing slashes (if any) from the input URL: $data_resource -> $data_resource_no_trailing_slash \n" if $debug_output;
print BOLD, YELLOW, "VALOR: Fetching data from $data_resource_no_trailing_slash\n", RESET;

# Calculate value for wget --cut-dirs argument
# Say the input archive URL is `https://valor.pp.rl.ac.uk/data_store/valor_inputs'
# Within that archive, data are stored (see README) in:
# `https://valor.pp.rl.ac.uk/data_store/valor_inputs/data/experiment/component/version/...'
# The wget -nH option will cut the `valor.pp.rl.ac.uk' part.
# We want the directory structure fetched locally to be `experiment/component/version/...'.
# Therefore, we need to cut the `/data_store/valor_inputs/data' part.
# This is accomplished using the wget --cut-dirs=value option.
# Here we determine that value
$data_resource_no_trailing_slash_no_http = $data_resource_no_trailing_slash;
$data_resource_no_trailing_slash_no_http =~ s/https\:\/\///; # remove optional http,  if any
$data_resource_no_trailing_slash_no_http =~ s/http\:\/\///;  # remove optional https, if any
@url_tokens = split(/\//, $data_resource_no_trailing_slash_no_http);
print "VALOR: Tokenizing URL $data_resource_no_trailing_slash_no_http --> \{ @url_tokens \} \n" if $debug_output;
$num_of_tokens = @url_tokens;
print "VALOR: Number of URL tokens: $num_of_tokens \n" if $debug_output;
$num_of_cut_dirs = $num_of_tokens;
#$num_of_cut_dirs -= 1; # remove hostname which is cut out by the -nH argument
#$num_of_cut_dirs += 1; # add the `data' directory which sits between the archive URL and the `experiment/component/version/ part

# Get date/time for reporting and tagging old files, if needed.
# ---------
# requires `use DateTime;'
#$dt   = DateTime->now;   # Stores current date and time as datetime object
#$date = $dt->ymd;        # Retrieves date as a string in 'yyyy-mm-dd' format
#$time = $dt->hms;        # Retrieves time as a string in 'hh:mm:ss' format
#$now_string = "$date\_$time";
# ---------
($sec,$min,$hour,$mday,$mon,$year,$wday,$yday,$isdst) = localtime();
$year += 1900; # $year in localtime() counts years from 1900...
my @mon_text = qw(Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec); # $mon in localtime() starts from 0...
$now_string = "$year-$mon_text[$mon]-$mday\_$hour:$min:$sec";

# Build some needed filenames
$inputs_id                   = "$data_major_q\_$data_minor_q\_$data_revis_q";
$checksum_file               = "$inputs_id.md5";
$checksum_file_w_local_path  = "$local_base_dir/$checksum_file";
$checksum_file_w_remote_path = "$data_resource_no_trailing_slash/checksums/$checksum_file";
$diff_file                   = "$inputs_id.diff";
$diff_file_w_local_path      = "$local_base_dir/$diff_file";
$remote_data_base_dir        = "$data_resource_no_trailing_slash/data";

#
# Download checksum file
#
print BOLD, CYAN, "\nVALOR: Downloading checksum file: $checksum_file_w_remote_path \n", RESET;
# If a similarly named file exists locally, rename old version or remove
if (-e $checksum_file_w_local_path)
{
  print "VALOR: $checksum_file_w_local_path already exists \n" if $debug_output;
  if($rm_obsolete == 1) {
    print "VALOR: Removing existing checksum file\n" if $debug_output;
    system("rm $checksum_file_w_local_path");
  } else {
    my $renamed_checksum_file_w_local_path = "$checksum_file_w_local_path~$now_string";
    print "VALOR: Renaming existing checksum file to $renamed_checksum_file_w_local_path \n" if $debug_output;
    system("mv $checksum_file_w_local_path $renamed_checksum_file_w_local_path");
  }
  die("VALOR: *** Failed to execute: $! *** \n") if ($? == -1);
}
# Now, do download...
if($use_wget) {
  system("cd $local_base_dir; wget --no-verbose $checksum_file_w_remote_path");
}
elsif($use_scp) {
  system("cd $local_base_dir; scp $checksum_file_w_remote_path .");
}
else {
  die("VALOR: *** Can't use `wget' nor `scp' \n");
}
die("VALOR: *** Failed to retrieve $checksum_file_w_remote_path *** \n") if(! -e $checksum_file_w_local_path);

#
# Generating diff file
#
print BOLD, YELLOW,"\nVALOR: Checking current files against checksum and generating diff file... \n", RESET;

# If the original data product was an emty directory, the md5 checksum file will have a single line that looks like
# d41d8cd98f00b204e9800998ecf8427e  -
# and generating a diff file will hang
open CHECKSUM_FILE, $checksum_file_w_local_path or die();
chomp(@checksum_file_entries = <CHECKSUM_FILE>);
close CHECKSUM_FILE;
$ignore_checksum = 0;
$num_of_checksum_file_entries = @checksum_file_entries;
print "VALOR: Number of checksum file entries: $num_of_checksum_file_entries \n" if $debug_output;
if($num_of_checksum_file_entries == 1)
{
  print "VALOR: Checksum file entry: `$checksum_file_entries[0]' \n" if $debug_output;
  if($checksum_file_entries[0] =~ m/^\w+ *-*$/) {
     print "VALOR: Checksum file will be ignored \n" if $debug_output;
     $ignore_checksum = 1;
  }
}
if($ignore_checksum) {
  print BOLD, YELLOW, "\nVALOR: Remote data product is an empty directory - Nothing to do \n", RESET;
  exit;
} 
# Now process a valid checksum file
# If a similarly named file exists locally, rename old version
if (-e $diff_file_w_local_path)
{
  print "VALOR: $diff_file_w_local_path already exists \n" if $debug_output;
  if($rm_obsolete == 1) {
    print "VALOR: Removing existing diff file \n" if $debug_output;
    system("rm $diff_file_w_local_path");
  } else {
    my $renamed_diff_file_w_local_path = "$diff_file_w_local_path~$now_string";
    print "VALOR: Renaming existing diff file to $renamed_diff_file_w_local_path \n" if $debug_output;
    system("mv $diff_file_w_local_path $renamed_diff_file_w_local_path");
  }
  die("VALOR: *** Failed to execute: $! *** \n") if ($? == -1);
}
# Now, do generate the diff file...
print "VALOR: Running md5sum to generate $diff_file \n" if $debug_output;
system("cd $local_base_dir; md5sum -c $checksum_file >> $diff_file 2>&1");
die("VALOR: *** Failed to generate the diff file $diff_file_w_local_path *** \n") if(! -e $diff_file_w_local_path);
print "VALOR: Done generating $diff_file \n" if $debug_output;

#
# Now, read the diff file and start updating the locally stored inputs
#
print BOLD, YELLOW, "\nVALOR: Reading in diff file: $diff_file \n", RESET;
open DIFF_FILE, $diff_file_w_local_path or die();
chomp(@diff_entries = <DIFF_FILE>);
close DIFF_FILE;

foreach(@diff_entries) {
  $current_diff = $_;
  print "VALOR: Current entry in diff file is shown between brackets: [$current_diff] \n" if $debug_output;

  # Found a remote file that doesn't exist locally? Fetch it now!
  # -------------------------------------------------------------
  if($current_diff =~ m/(.*)\: FAILED open or read/) {
    $current_file = $1;
    print BOLD, BRIGHT_RED, "VALOR: Remote file $current_file does not exist locally. \n", RESET;
    print BOLD, CYAN, "VALOR: Downloading new file $current_file... \n", RESET;
    if($use_wget) {
      system("cd $local_base_dir; wget --no-verbose --force-directories -nH --cut-dirs=$num_of_cut_dirs $remote_data_base_dir/$current_file");
    }
    elsif($use_scp) {
      $local_path = $local_base_dir . "/" . dirname($current_file);
      print BOLD, CYAN, "VALOR: Creating directory [$local_path] \n", RESET;
      mkpath ($local_path, {verbose => 1, mode=>0777});
      system("cd $local_path; scp $remote_data_base_dir/$current_file .");
    }
  }

  # Remote file was modified! Update local file.
  # -------------------------------------------------------------
  elsif($current_diff =~ m/(.*)\: FAILED$/) {
    $current_file = $1;
    $current_file_w_local_path = "$local_base_dir/$current_file";
    print BOLD, BRIGHT_RED, "VALOR: File $current_file was modified! \n", RESET;
    if($rm_obsolete == 1) {
      print "VALOR: Removing obsolete version of $current_file! \n" if $debug_output;
      system("rm $current_file_w_local_path");
    } else {
      print "VALOR: Renaming obsolete version of $current_file! \n" if $debug_output;
      my $renamed_current_file_w_local_path = "$current_file_w_local_path~$now_string";
      system("mv $current_file_w_local_path $renamed_current_file_w_local_path");
    }
    print BOLD, CYAN, "VALOR: Downloading updated file $current_file... \n", RESET;
    if($use_wget) {
      system("cd $local_base_dir; wget --no-verbose --force-directories -nH --cut-dirs=$num_of_cut_dirs $remote_data_base_dir/$current_file");
    }
    elsif($use_scp) {
      $local_path = $local_base_dir . "/" . dirname($current_file);
      system("cd $local_path; scp $remote_data_base_dir/$current_file .");
    }
  }

  # Current file is up to date
  # -------------------------------------------------------------
  elsif($current_diff =~ m/(.*)\: OK/) {
    $current_file = $1;
    print BOLD, GREEN, "VALOR: File $current_file is up to date. \n", RESET;
  }

} # loop over @diff_entries

print BOLD, YELLOW, "\n\nVALOR: Done fetching files \n\n", RESET;
