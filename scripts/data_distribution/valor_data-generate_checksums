#!/usr/bin/perl

#
#-------------------------------------------------------------------------------------------------------------------------------
# Generate and save checksums for a VALOR data set.
# See the README file for the VALOR data archive directory structure.
#
# Inputs:
#    [--archive-path] : Local path to a VALOR archive area visible from the web. [Default: .]
#     --data-major    : Major qualifier for a set of VALOR inputs.
#    [--data-minor]   : Major qualifier for a set of VALOR inputs. Wildcards allowed. [Default: *]
#    [--data-revis]   : Revision qualifier for a set of VALOR inputs. Wildcards allowed. [Default: *]
#
# Examples:
# ---------
# 1) Generate checksum for dune/ndfit/2017a data files and store in checksums/dune_ndfit_2017a.md5 (see above):
#    % valor_data-generate_checksums --data-major dune --data-minor ndfit --data-revis 2017a --archive-path /some/path/
#
# C. Andreopoulos <costas.andreopoulos@stfc.ac.uk>
# University of Liverpool & STFC/RAL
#-------------------------------------------------------------------------------------------------------------------------------
#

use Term::ANSIColor;
use Term::ANSIColor qw(:constants);

$iarg=0;
foreach (@ARGV) {

  if   ($_ eq '--archive-path' ) { $archive_path = $ARGV[$iarg+1]; }
  elsif($_ eq '--data-major'   ) { $data_major_q = $ARGV[$iarg+1]; }
  elsif($_ eq '--data-minor'   ) { $data_minor_q = $ARGV[$iarg+1]; }
  elsif($_ eq '--data-revis'   ) { $data_revis_q = $ARGV[$iarg+1]; }
  $iarg++;
}
die("VALOR: Please provide an input for --data-major") unless defined $data_major_q;

$data_minor_q = "*" unless defined $data_minor_q;
$data_revis_q = "*" unless defined $data_revis_q;
$archive_path = "." unless defined $archive_path;

print "\n";
print BOLD, YELLOW, "VALOR: Creating checksums for the data product(s) with [major qualifier: $data_major_q / minor qualifier: $data_minor_q / revision qualifier: $data_revis_q]\n", RESET;
print BOLD, YELLOW, "VALOR: Data archive path: $archive_path \n", RESET;

$inputs_path   = "$data_major_q/$data_minor_q/$data_revis_q";
$inputs_id     = "$data_major_q\_$data_minor_q\_$data_revis_q";
$checksum_file = "$inputs_id.md5";

print BOLD, CYAN, "\nVALOR: Running: cd $archive_path/data; find $inputs_path -type f -print0 | xargs -0 md5sum > $archive_path/checksums/$checksum_file \n\n", RESET;

system("cd $archive_path/data; find $inputs_path -type f -print0 | xargs -0 md5sum > $archive_path/checksums/$checksum_file");

print BOLD, YELLOW, "VALOR: Done generating checksums \n\n", RESET;
