
<!ELEMENT valor (element_list,systematics) >
  <!ELEMENT element_list (element+) >
    <!ATTLIST element_list name CDATA #IMPLIED>
      <!ELEMENT element (detector,beam,sample,observable,data?,mc,data_class?,model_class?,binning) >
      <!ATTLIST element name CDATA #IMPLIED>
      <!ELEMENT detector    (#PCDATA) >
      <!ELEMENT beam        (#PCDATA) >
      <!ELEMENT sample      (#PCDATA) >
      <!ELEMENT observable  (#PCDATA) >
      <!ELEMENT data        (#PCDATA) >
      <!ELEMENT mc          (#PCDATA) >
      <!ELEMENT data_class  (#PCDATA) >
      <!ELEMENT model_class (#PCDATA) >
      <!ELEMENT binning     (#PCDATA) >
  <!ELEMENT systematics (group+) >
    <!ATTLIST systematics name CDATA #IMPLIED>
    <!ELEMENT group (class?,covariance_matrix,untuned_values?,initial_values?,force_uncorrelated?) >
     <!ATTLIST group name CDATA #IMPLIED>
     <!ELEMENT class (#PCDATA)>
     <!ELEMENT covariance_matrix (filename,objname,objtype) >
     <!ELEMENT untunted_values   (filename,objname,objtype) >
     <!ELEMENT initial_values    (filename,objname,objtype) >
       <!ELEMENT filename (#PCDATA) >
       <!ELEMENT objname  (#PCDATA) >
       <!ELEMENT objtype  (#PCDATA) >
     <!ELEMENT force_uncorrelated (#PCDATA) >
