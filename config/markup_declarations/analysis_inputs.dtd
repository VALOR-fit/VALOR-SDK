
<!ELEMENT analysis_inputs (data,fiducial_mass?,mc,splines) >
  <!ATTLIST analysis_inputs type    CDATA #IMPLIED>
  <!ATTLIST analysis_inputs version CDATA #IMPLIED>
  
  <!ELEMENT data (exposure) >
    <!ELEMENT exposure (fhc,rhc) >
      <!ELEMENT fhc (#PCDATA) >
      <!ELEMENT rhc (#PCDATA) >
  
  <!ELEMENT fiducial_mass (#PCDATA) >
  
  <!ELEMENT mc (using_dst_format,dst,template,interaction_mass?) >
    <!ELEMENT using_dst_format (#PCDATA) >
    <!ELEMENT dst (lbne_fhc,lbne_rhc) >
     <!ELEMENT lbne_fhc (filename,objname,objtype) >
     <!ELEMENT lbne_rhc (filename,objname,objtype) >
	   <!ELEMENT filename (#PCDATA) >
       <!ELEMENT objname  (#PCDATA) >
       <!ELEMENT objtype  (#PCDATA) >
     
     <!ELEMENT template (filename,tag) >

       <!-- defined above <!ELEMENT filename (#PCDATA) > -->
       <!ELEMENT tag      (#PCDATA) >
       
    <!ELEMENT interaction_mass (#PCDATA) >
    
  <!ELEMENT splines (folder,pattern) >
   <!ELEMENT folder  (#PCDATA) >
   <!ELEMENT pattern (#PCDATA) >

